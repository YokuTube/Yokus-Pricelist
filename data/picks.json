{
  "_hinweis": "Auswahlhilfen zu Befehlen: Bei diesen Befehlen zeigt die Seite die möglichen Werte als antippbare Knöpfe. 'from' = Liste aus den Daten (weather, races, xenotypes) oder aus choices.json (colors, hairColors, skills, raidTypes, raidStrategies); 'values' = feste Liste; {c} = der gewählte Wert, {r} = erste Rasse (z. B. human).",
  "pawn": [
    { "label": "Rasse wählen", "from": "races", "template": "!pawn {c}" },
    { "label": "Xenotyp wählen (für {r})", "from": "xenotypes", "template": "!pawn {r} {c}" }
  ],
  "weather": [ { "label": "Wetter wählen", "from": "weather", "template": "!weather {c}" } ],
  "raid": [
    { "label": "Art wählen", "from": "raidTypes", "template": "!raid {c}" },
    { "label": "Strategie wählen (mit Art standard)", "from": "raidStrategies", "template": "!raid standard {c}" }
  ],
  "passion": [ { "label": "Fertigkeit wählen (Einsatz 100 – danach anpassen)", "from": "skills", "template": "!passion {c} 100" } ],
  "hostility": [ { "label": "Verhalten wählen", "values": ["flee", "attack", "ignore"], "template": "!hostility {c}" } ],
  "work": [ { "label": "Tätigkeit wählen", "values": ["sleep", "joy"], "template": "!work {c}" } ],
  "sethead": [ { "label": "Auswahl", "values": ["list"], "template": "!sethead {c}" } ],
  "setbody": [ { "label": "Auswahl", "values": ["list"], "template": "!setbody {c}" } ],
  "sethair": [ { "label": "Auswahl", "values": ["list"], "template": "!sethair {c}" } ],
  "setbeard": [ { "label": "Auswahl", "values": ["list"], "template": "!setbeard {c}" } ],
