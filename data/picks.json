  "setskin": [
    { "label": "Auswahl", "values": ["list"], "template": "!setskin {c}" },
    { "label": "Farbe wählen", "from": "colors", "template": "!setskin {c}" }
  ],
  "dyehair": [
    { "label": "Auswahl", "values": ["list", "genes"], "template": "!dyehair {c}" },
    { "label": "Haarfarbe wählen", "from": "hairColors", "template": "!dyehair {c}" }
  ],
  "dye": [ { "label": "Farbe wählen", "from": "colors", "template": "!dye {c}" } ],
  "setfavoritecolor": [ { "label": "Farbe wählen", "from": "colors", "template": "!setfavoritecolor {c}" } ],
  "setstyle": [ { "label": "Auswahl", "values": ["list"], "template": "!setstyle {c}" } ],
  "geneedit": [
    { "label": "Aktion wählen", "values": ["activate"], "template": "!geneedit {c}" },
    { "label": "Xenotyp wählen (für {r})", "from": "xenotypes", "template": "!geneedit set {c}" }
  ],
  "surgery": [ { "label": "Eingriff wählen", "values": ["genderswap", "fat body", "thin body", "hulking body", "masculine body", "feminine body", "transfusion", "hemogen", "sterilize", "tubal", "vasectomy", "iud", "iudremove", "vasreverse", "terminate"], "template": "!surgery {c}" } ],
  "lookup": [ { "label": "Wonach suchen?", "values": ["item", "event", "weather", "trait", "race", "xenotype"], "template": "!lookup {c} " } ],
  "mypawn": [ { "label": "Was anzeigen?", "values": ["needs", "health", "implants", "gear", "weapon", "skills", "stats", "traits", "story", "work", "job", "relations", "family", "friends", "rivals", "genes", "kills"], "template": "!mypawn {c}" } ],
  "isekai": [ { "label": "Wert wählen", "values": ["str", "dex", "vit", "int", "wis", "cha"], "template": "!isekai level {c}" } ],
  "sidearms": [ { "label": "Auswahl", "values": ["list", "equip unarmed"], "template": "!sidearms {c}" } ],
